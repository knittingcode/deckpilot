{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knittingcode.github.io/deckpilot-plugins/v1/schemas/inputs/editorial.schema.json",
  "title": "DeckPilot storefront: editorial/editorial.json (owner source)",
  "description": "Storefront design §3.2. Maintainer-only. Drafts and archived entries stay here; only `published` entries reach the signed document. No external links: banner targets are plugins, collections or categories. `deckpilot-registry storefront check` enforces the rest (unique ids, windows, text and media rules).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "editorial_version",
    "sections"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "editorial_version": {
      "const": 1
    },
    "sections": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "banner_carousel",
              "collection_row",
              "spotlight",
              "recently_added",
              "category_highlights",
              "catalog"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "banner_carousel"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "order",
                "status",
                "items"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,48}$"
                },
                "status": {
                  "enum": [
                    "draft",
                    "published",
                    "archived"
                  ]
                },
                "kind": {
                  "const": "banner_carousel"
                },
                "order": {
                  "type": "integer"
                },
                "window": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "starts_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "ends_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "platforms": {
                  "$ref": "#/$defs/platforms"
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "title",
                      "artwork",
                      "target"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]{1,48}$"
                      },
                      "title": {
                        "$ref": "#/$defs/text60"
                      },
                      "body": {
                        "$ref": "#/$defs/text160"
                      },
                      "artwork": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "file"
                        ],
                        "properties": {
                          "file": {
                            "$ref": "#/$defs/file/properties/file"
                          },
                          "alt": {
                            "type": "object",
                            "propertyNames": {
                              "pattern": "^(en|pl)$"
                            },
                            "additionalProperties": {
                              "type": "string",
                              "maxLength": 250
                            }
                          },
                          "decorative": {
                            "type": "boolean"
                          }
                        }
                      },
                      "target": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "id"
                        ],
                        "properties": {
                          "type": {
                            "enum": [
                              "plugin",
                              "collection",
                              "category"
                            ]
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 104
                          }
                        }
                      },
                      "cta": {
                        "$ref": "#/$defs/text24"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "collection_row"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "order",
                "status",
                "title",
                "plugins"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,48}$"
                },
                "status": {
                  "enum": [
                    "draft",
                    "published",
                    "archived"
                  ]
                },
                "kind": {
                  "const": "collection_row"
                },
                "order": {
                  "type": "integer"
                },
                "window": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "starts_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "ends_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "platforms": {
                  "$ref": "#/$defs/platforms"
                },
                "layout": {
                  "enum": [
                    "cards",
                    "compact"
                  ]
                },
                "title": {
                  "$ref": "#/$defs/text40"
                },
                "description": {
                  "$ref": "#/$defs/text300"
                },
                "plugins": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 24,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 57,
                    "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*\\.[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "spotlight"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "order",
                "status",
                "plugin",
                "headline"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,48}$"
                },
                "status": {
                  "enum": [
                    "draft",
                    "published",
                    "archived"
                  ]
                },
                "kind": {
                  "const": "spotlight"
                },
                "order": {
                  "type": "integer"
                },
                "window": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "starts_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "ends_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "platforms": {
                  "$ref": "#/$defs/platforms"
                },
                "plugin": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 57,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*\\.[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
                },
                "headline": {
                  "$ref": "#/$defs/text60"
                },
                "body": {
                  "$ref": "#/$defs/text300"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "recently_added"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "order",
                "status",
                "limit"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,48}$"
                },
                "status": {
                  "enum": [
                    "draft",
                    "published",
                    "archived"
                  ]
                },
                "kind": {
                  "const": "recently_added"
                },
                "order": {
                  "type": "integer"
                },
                "window": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "starts_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "ends_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "platforms": {
                  "$ref": "#/$defs/platforms"
                },
                "limit": {
                  "type": "integer",
                  "minimum": 4,
                  "maximum": 24
                },
                "title": {
                  "$ref": "#/$defs/text40"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "category_highlights"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "order",
                "status",
                "categories"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,48}$"
                },
                "status": {
                  "enum": [
                    "draft",
                    "published",
                    "archived"
                  ]
                },
                "kind": {
                  "const": "category_highlights"
                },
                "order": {
                  "type": "integer"
                },
                "window": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "starts_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "ends_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "platforms": {
                  "$ref": "#/$defs/platforms"
                },
                "title": {
                  "$ref": "#/$defs/text40"
                },
                "categories": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z-]{2,24}$"
                      },
                      "blurb": {
                        "$ref": "#/$defs/text120"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "catalog"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "order",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,48}$"
                },
                "status": {
                  "enum": [
                    "draft",
                    "published",
                    "archived"
                  ]
                },
                "kind": {
                  "const": "catalog"
                },
                "order": {
                  "type": "integer"
                },
                "window": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "starts_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "ends_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "platforms": {
                  "$ref": "#/$defs/platforms"
                },
                "title": {
                  "$ref": "#/$defs/text40"
                }
              }
            }
          }
        ]
      }
    },
    "collections": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "title",
          "plugins",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,48}$"
          },
          "status": {
            "enum": [
              "draft",
              "published",
              "archived"
            ]
          },
          "order": {
            "type": "integer"
          },
          "title": {
            "$ref": "#/$defs/text40"
          },
          "description": {
            "$ref": "#/$defs/text300"
          },
          "plugins": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 5,
              "maxLength": 57,
              "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*\\.[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text24": {
      "type": "object",
      "required": [
        "en"
      ],
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(en|pl)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      }
    },
    "text40": {
      "type": "object",
      "required": [
        "en"
      ],
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(en|pl)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "text60": {
      "type": "object",
      "required": [
        "en"
      ],
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(en|pl)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      }
    },
    "text80": {
      "type": "object",
      "required": [
        "en"
      ],
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(en|pl)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "text120": {
      "type": "object",
      "required": [
        "en"
      ],
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(en|pl)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "text160": {
      "type": "object",
      "required": [
        "en"
      ],
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(en|pl)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "text250": {
      "type": "object",
      "required": [
        "en"
      ],
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(en|pl)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 250
      }
    },
    "text300": {
      "type": "object",
      "required": [
        "en"
      ],
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(en|pl)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "text2000": {
      "type": "object",
      "required": [
        "en"
      ],
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(en|pl)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "text6000": {
      "type": "object",
      "required": [
        "en"
      ],
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(en|pl)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 6000
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "macos",
          "windows",
          "linux"
        ]
      }
    },
    "url": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^https://[a-z0-9.-]+(?:[/?#][\\x21-\\x7e]*)?$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^media/[a-z0-9-]{1,48}\\.(png|webp|jpg)$"
        }
      }
    },
    "art": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/file/properties/file"
        },
        "alt": {
          "$ref": "#/$defs/text250"
        },
        "decorative": {
          "type": "boolean"
        }
      }
    }
  }
}
